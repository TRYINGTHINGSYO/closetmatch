# ClosetMatch environment variables
# Copy to .env for local development. Never commit secrets.

# Supabase (required for cloud auth/storage/RLS)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# AI provider selection for client abstractions
# mock = local deterministic analysis (default, no key needed)
# openai = invoke Supabase Edge Functions (server holds OPENAI_API_KEY)
EXPO_PUBLIC_AI_PROVIDER=mock

# Weather provider: open-meteo (default) or mock
EXPO_PUBLIC_WEATHER_PROVIDER=open-meteo

# --- Server-only (Supabase Edge Function secrets) ---
# OPENAI_API_KEY=
# REMOVE_BG_API_KEY=
