{
  "expo": {
    "name": "ClosetMatch",
    "slug": "closetmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "closetmatch",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.closetmatch.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ClosetMatch uses the camera to photograph clothing and optional Mirror Check outfits.",
        "NSPhotoLibraryUsageDescription": "ClosetMatch lets you upload clothing and Mirror Check photos from your library.",
        "NSLocationWhenInUseUsageDescription": "ClosetMatch uses your location only when you enable weather-based outfit suggestions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F0ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.closetmatch.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "ClosetMatch",
      "shortName": "ClosetMatch"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F4"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ClosetMatch to access photos for clothing and Mirror Check.",
          "cameraPermission": "Allow ClosetMatch to use the camera for clothing and Mirror Check."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow ClosetMatch to use your location for weather-aware outfit suggestions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "closetmatch-local"
      }
    }
  }
}
